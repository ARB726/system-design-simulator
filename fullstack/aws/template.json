{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Systems Lab: private static website, authenticated FastAPI, queued SimPy workers and durable per-user results. Region us-east-2; local SQLite/PostgreSQL fallback is independent of AWS.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    },
    "com.aws.cloudformation.Context": {
      "ref": [
        "fullstack/aws/DEPLOY.md"
      ],
      "must": [
        "No AWS Organizations or paid-plan upgrades. Deploy only after billing context is confirmed."
      ]
    }
  },
  "Parameters": {
    "CodeBucket": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]"
    },
    "CodeKey": {
      "Type": "String",
      "AllowedPattern": "packages/[A-Za-z0-9._/-]+\\.zip"
    }
  },
  "Resources": {
    "Website": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Static export served only through CloudFront origin access control.",
          "must": [
            "Private; TLS-only; retain data on stack deletion."
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "WebsitePolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Website"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Website",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Website.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": false
                }
              }
            },
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${Website.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Require HTTPS for every object operation.",
          "must": []
        }
      }
    },
    "Results": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Durable aggregated experiment results; no request traces or credentials.",
          "must": [
            "Private; TLS-only; retain data on stack deletion."
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ResultsPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Results"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Results",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Results.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": false
                }
              }
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Require HTTPS for every object operation.",
          "must": []
        }
      }
    },
    "Jobs": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "owner",
            "AttributeType": "S"
          },
          {
            "AttributeName": "id",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "owner",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "id",
            "KeyType": "RANGE"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": false
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Per-user job metadata and transactional active-job counters. On-demand avoids provisioned idle compute.",
          "must": [
            "Every access must be partitioned by authenticated owner."
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "DeadLetters": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "SqsManagedSseEnabled": true,
        "MessageRetentionPeriod": 1209600,
        "VisibilityTimeout": 180
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Failed messages trigger terminal job state and release active-job quota.",
          "must": []
        }
      }
    },
    "Queue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "SqsManagedSseEnabled": true,
        "VisibilityTimeout": 1800,
        "MessageRetentionPeriod": 86400,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "DeadLetters",
              "Arn"
            ]
          },
          "maxReceiveCount": 3
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Separate simulation execution from the 30-second HTTP integration.",
          "must": [
            "Visibility timeout >= six times worker timeout."
          ]
        }
      }
    },
    "QueuePolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "Queues": [
          {
            "Ref": "Queue"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "sqs:*",
              "Resource": {
                "Fn::GetAtt": [
                  "Queue",
                  "Arn"
                ]
              },
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": false
                }
              }
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Require encrypted transport for queue access.",
          "must": []
        }
      }
    },
    "DeadLettersPolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "Queues": [
          {
            "Ref": "DeadLetters"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "sqs:*",
              "Resource": {
                "Fn::GetAtt": [
                  "DeadLetters",
                  "Arn"
                ]
              },
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": false
                }
              }
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Require encrypted transport for queue access.",
          "must": []
        }
      }
    },
    "OriginAccess": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-website"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Signed origin requests keep the website bucket private.",
          "must": []
        }
      }
    },
    "Headers": {
      "Type": "AWS::CloudFront::ResponseHeadersPolicy",
      "Properties": {
        "ResponseHeadersPolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-security"
          },
          "SecurityHeadersConfig": {
            "ContentTypeOptions": {
              "Override": true
            },
            "FrameOptions": {
              "FrameOption": "DENY",
              "Override": true
            },
            "ReferrerPolicy": {
              "ReferrerPolicy": "strict-origin-when-cross-origin",
              "Override": true
            },
            "StrictTransportSecurity": {
              "AccessControlMaxAgeSec": 31536000,
              "Override": true
            },
            "ContentSecurityPolicy": {
              "ContentSecurityPolicy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://*.execute-api.us-east-2.amazonaws.com https://*.auth.us-east-2.amazoncognito.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'",
              "Override": true
            }
          }
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Browser security headers for the exported application. Inline scripts are required by Next.js static hydration.",
          "must": []
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "Systems Lab static frontend",
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2",
          "PriceClass": "PriceClass_100",
          "Origins": [
            {
              "Id": "website",
              "DomainName": {
                "Fn::GetAtt": [
                  "Website",
                  "RegionalDomainName"
                ]
              },
              "OriginAccessControlId": {
                "Ref": "OriginAccess"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "website",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "ForwardedValues": {
              "QueryString": false,
              "Cookies": {
                "Forward": "none"
              }
            },
            "MinTTL": 0,
            "DefaultTTL": 60,
            "MaxTTL": 86400,
            "ResponseHeadersPolicyId": {
              "Ref": "Headers"
            }
          },
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          }
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Global HTTPS delivery for a static frontend; Python stays in the selected Region.",
          "must": []
        }
      }
    },
    "Users": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": {
          "Fn::Sub": "${AWS::StackName}-users"
        },
        "UserPoolTier": "LITE",
        "UsernameAttributes": [
          "email"
        ],
        "AutoVerifiedAttributes": [
          "email"
        ],
        "UsernameConfiguration": {
          "CaseSensitive": false
        },
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 12,
            "RequireLowercase": true,
            "RequireUppercase": true,
            "RequireNumbers": true,
            "RequireSymbols": false
          }
        },
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "verified_email",
              "Priority": 1
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Verified email sign-up and hosted OAuth sign-in.",
          "must": [
            "No browser client secret; never export passwords or tokens."
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "LoginDomain": {
      "Type": "AWS::Cognito::UserPoolDomain",
      "Properties": {
        "Domain": {
          "Fn::Sub": "systemslab-${AWS::AccountId}-${AWS::Region}"
        },
        "UserPoolId": {
          "Ref": "Users"
        },
        "ManagedLoginVersion": 1
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Classic hosted UI avoids a paid branding dependency.",
          "must": []
        }
      }
    },
    "WebClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "UserPoolId": {
          "Ref": "Users"
        },
        "ClientName": "systems-lab-browser",
        "GenerateSecret": false,
        "SupportedIdentityProviders": [
          "COGNITO"
        ],
        "AllowedOAuthFlowsUserPoolClient": true,
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthScopes": [
          "openid",
          "email"
        ],
        "CallbackURLs": [
          {
            "Fn::Sub": "https://${Distribution.DomainName}/"
          }
        ],
        "LogoutURLs": [
          {
            "Fn::Sub": "https://${Distribution.DomainName}/"
          }
        ],
        "AccessTokenValidity": 60,
        "IdTokenValidity": 60,
        "RefreshTokenValidity": 1,
        "TokenValidityUnits": {
          "AccessToken": "minutes",
          "IdToken": "minutes",
          "RefreshToken": "days"
        },
        "EnableTokenRevocation": true,
        "PreventUserExistenceErrors": "ENABLED"
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Public SPA uses authorization code with PKCE; tokens stay in browser session storage.",
          "must": []
        }
      }
    },
    "ApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:Query",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Jobs",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Results.Arn}/results/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Queue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-*:log-stream:*"
                  }
                }
              ]
            }
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Scoped service execution permissions; no human roles or administrative policies.",
          "must": []
        }
      }
    },
    "WorkerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "runtime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:Query",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Jobs",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Results.Arn}/results/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "Queue",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "DeadLetters",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Results.Arn}/results/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-*:log-stream:*"
                  }
                }
              ]
            }
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Scoped service execution permissions; no human roles or administrative policies.",
          "must": []
        }
      }
    },
    "ApiLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-api"
        },
        "RetentionInDays": 7
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Bound diagnostic retention and avoid logging request bodies, credentials, or result data.",
          "must": []
        }
      }
    },
    "ApiFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "Runtime": "python3.12",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "fullstack.backend.main.handler",
        "Role": {
          "Fn::GetAtt": [
            "ApiRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "MemorySize": 512,
        "Timeout": 29,
        "Environment": {
          "Variables": {
            "STORAGE_MODE": "aws",
            "JOBS_TABLE": {
              "Ref": "Jobs"
            },
            "RESULTS_BUCKET": {
              "Ref": "Results"
            },
            "JOBS_QUEUE_URL": {
              "Ref": "Queue"
            },
            "SYSDESIGN_MAX_ARRIVALS": "150000",
            "COGNITO_ISSUER": {
              "Fn::Sub": "https://cognito-idp.${AWS::Region}.amazonaws.com/${Users}"
            },
            "COGNITO_CLIENT_ID": {
              "Ref": "WebClient"
            },
            "COGNITO_DOMAIN": {
              "Fn::Sub": "https://${LoginDomain}.auth.${AWS::Region}.amazoncognito.com"
            },
            "ALLOWED_ORIGINS": {
              "Fn::Sub": "https://${Distribution.DomainName}"
            }
          }
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "On-demand Python execution; no EC2, RDS, Redis, NAT gateway, or load balancer idle charges.",
          "must": [
            "Keep regional resources in us-east-2; enforce owner and workload limits."
          ]
        }
      },
      "DependsOn": [
        "ApiLogs"
      ]
    },
    "WorkerLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-worker"
        },
        "RetentionInDays": 7
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Bound diagnostic retention and avoid logging request bodies, credentials, or result data.",
          "must": []
        }
      }
    },
    "WorkerFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-worker"
        },
        "Runtime": "python3.12",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "fullstack.backend.worker.handler",
        "Role": {
          "Fn::GetAtt": [
            "WorkerRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "MemorySize": 1024,
        "Timeout": 300,
        "Environment": {
          "Variables": {
            "STORAGE_MODE": "aws",
            "JOBS_TABLE": {
              "Ref": "Jobs"
            },
            "RESULTS_BUCKET": {
              "Ref": "Results"
            },
            "JOBS_QUEUE_URL": {
              "Ref": "Queue"
            },
            "SYSDESIGN_MAX_ARRIVALS": "150000",
            "COGNITO_ISSUER": {
              "Fn::Sub": "https://cognito-idp.${AWS::Region}.amazonaws.com/${Users}"
            },
            "COGNITO_CLIENT_ID": {
              "Ref": "WebClient"
            },
            "COGNITO_DOMAIN": {
              "Fn::Sub": "https://${LoginDomain}.auth.${AWS::Region}.amazoncognito.com"
            },
            "ALLOWED_ORIGINS": {
              "Fn::Sub": "https://${Distribution.DomainName}"
            }
          }
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "On-demand Python execution; no EC2, RDS, Redis, NAT gateway, or load balancer idle charges.",
          "must": [
            "Keep regional resources in us-east-2; enforce owner and workload limits."
          ]
        }
      },
      "DependsOn": [
        "WorkerLogs"
      ]
    },
    "RecoveryLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-recovery"
        },
        "RetentionInDays": 7
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Bound diagnostic retention and avoid logging request bodies, credentials, or result data.",
          "must": []
        }
      }
    },
    "RecoveryFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-recovery"
        },
        "Runtime": "python3.12",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "fullstack.backend.worker.dead_letter_handler",
        "Role": {
          "Fn::GetAtt": [
            "WorkerRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "MemorySize": 256,
        "Timeout": 30,
        "Environment": {
          "Variables": {
            "STORAGE_MODE": "aws",
            "JOBS_TABLE": {
              "Ref": "Jobs"
            },
            "RESULTS_BUCKET": {
              "Ref": "Results"
            },
            "JOBS_QUEUE_URL": {
              "Ref": "Queue"
            },
            "SYSDESIGN_MAX_ARRIVALS": "150000",
            "COGNITO_ISSUER": {
              "Fn::Sub": "https://cognito-idp.${AWS::Region}.amazonaws.com/${Users}"
            },
            "COGNITO_CLIENT_ID": {
              "Ref": "WebClient"
            },
            "COGNITO_DOMAIN": {
              "Fn::Sub": "https://${LoginDomain}.auth.${AWS::Region}.amazoncognito.com"
            },
            "ALLOWED_ORIGINS": {
              "Fn::Sub": "https://${Distribution.DomainName}"
            }
          }
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "On-demand Python execution; no EC2, RDS, Redis, NAT gateway, or load balancer idle charges.",
          "must": [
            "Keep regional resources in us-east-2; enforce owner and workload limits."
          ]
        }
      },
      "DependsOn": [
        "RecoveryLogs"
      ]
    },
    "WorkerMapping": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "EventSourceArn": {
          "Fn::GetAtt": [
            "Queue",
            "Arn"
          ]
        },
        "FunctionName": {
          "Ref": "WorkerFunction"
        },
        "BatchSize": 1,
        "Enabled": true,
        "ScalingConfig": {
          "MaximumConcurrency": 2
        },
        "FunctionResponseTypes": [
          "ReportBatchItemFailures"
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Bound queue concurrency; partial failures are retried instead of losing experiments.",
          "must": []
        }
      }
    },
    "RecoveryMapping": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "EventSourceArn": {
          "Fn::GetAtt": [
            "DeadLetters",
            "Arn"
          ]
        },
        "FunctionName": {
          "Ref": "RecoveryFunction"
        },
        "BatchSize": 1,
        "Enabled": true,
        "ScalingConfig": {
          "MaximumConcurrency": 2
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Bound queue concurrency; partial failures are retried instead of losing experiments.",
          "must": []
        }
      }
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "ProtocolType": "HTTP",
        "CorsConfiguration": {
          "AllowOrigins": [
            {
              "Fn::Sub": "https://${Distribution.DomainName}"
            }
          ],
          "AllowMethods": [
            "GET",
            "POST",
            "OPTIONS"
          ],
          "AllowHeaders": [
            "authorization",
            "content-type"
          ],
          "MaxAge": 600
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "HTTP API fronts FastAPI; app validates Cognito access tokens and enforces ownership.",
          "must": []
        }
      }
    },
    "Integration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "ApiFunction",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 29000
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "HTTP requests submit or read jobs; never run the simulation inline.",
          "must": []
        }
      }
    },
    "Route": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "ANY /api/{proxy+}",
        "Target": {
          "Fn::Join": [
            "",
            [
              "integrations/",
              {
                "Ref": "Integration"
              }
            ]
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Forward only the API path to FastAPI.",
          "must": []
        }
      }
    },
    "Stage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 5,
          "ThrottlingRateLimit": 2
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Small public-demo request limits bound bursts; they are not a monetary spending cap.",
          "must": []
        }
      }
    },
    "ApiPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "ApiFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*/*/api/*"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Only this project API may invoke the HTTP function.",
          "must": []
        }
      }
    }
  },
  "Outputs": {
    "WebsiteUrl": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}"
      }
    },
    "WebsiteBucket": {
      "Value": {
        "Ref": "Website"
      }
    },
    "ApiUrl": {
      "Value": {
        "Fn::GetAtt": [
          "HttpApi",
          "ApiEndpoint"
        ]
      }
    },
    "ResultsBucket": {
      "Value": {
        "Ref": "Results"
      }
    },
    "JobsTable": {
      "Value": {
        "Ref": "Jobs"
      }
    },
    "UserPool": {
      "Value": {
        "Ref": "Users"
      }
    },
    "ClientId": {
      "Value": {
        "Ref": "WebClient"
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      }
    }
  }
}
